# SiloNR environment
# Copy to .env locally. Never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

# Explicit build mode. Real customer deployments MUST use false.
# Set true only for a public/demo build that intentionally bypasses authentication.
VITE_ENABLE_DEMO=false

# PostgreSQL used by the production backend.
DATABASE_URL=postgresql://silonr:change-me@localhost:5432/silonr
# Local/on-prem internal Docker network: disable.
# Managed/external PostgreSQL in production: verify-full.
DATABASE_SSL_MODE=disable

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Keep false in normal customer deployments. Provisioning/invitation flows create users;
# the public sign-up endpoint must not become an open registration page.
ALLOW_PUBLIC_SIGNUP=false

# Private S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.).
# Native Windows installer selects filesystem and generates the signing secret.
STORAGE_DRIVER=s3
FILE_STORAGE_PATH=
FILE_DOWNLOAD_SIGNING_SECRET=
# S3_ENDPOINT is the server-side endpoint used for PUT/DELETE. In an on-prem stack it
# may be an internal address such as http://minio:9000.
# S3_PUBLIC_ENDPOINT is optional and is used only when signing temporary download URLs;
# set it when browsers must reach the same private bucket through a public HTTPS host.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=silonr-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Monthly licensing. The local server calls Supabase Edge Functions; clients never do.
# See LICENSING.md for the exact sandbox -> production replacement map.
LICENSE_SERVICE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
LICENSE_CLIENT_API_KEY=REPLACE_WITH_RANDOM_SHARED_CLIENT_KEY
LICENSE_SIGNING_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_KEY_BASE64
LICENSE_INSTALLATION_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_32_BYTE_BASE64_KEY
LICENSE_REFRESH_INTERVAL_HOURS=24

# Optional observability. Keep empty in local/demo mode.
SENTRY_DSN=

# Email provider credentials are intentionally not prescribed here.
# Configure only when notifications are enabled.
