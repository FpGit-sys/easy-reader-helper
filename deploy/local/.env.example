# Use a fixed private IPv4 address assigned to the server PC.
SILONR_LOCAL_SERVER=silonr.local
SILONR_LOCAL_BIND_IP=192.168.1.50

POSTGRES_DB=silonr
POSTGRES_USER=silonr
POSTGRES_PASSWORD=replace-with-a-unique-32-character-password

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

MINIO_ROOT_USER=replace-root-user
MINIO_ROOT_PASSWORD=replace-with-a-unique-32-character-password
S3_BUCKET=silonr-evidence
S3_ACCESS_KEY_ID=replace-app-user
S3_SECRET_ACCESS_KEY=replace-with-a-different-32-character-password

# Prefer an external disk or NAS mounted on the server.
LOCAL_BACKUP_DIR=/var/backups/silonr-local
LOCAL_BACKUP_RETENTION_DAYS=30

# Monthly license connection. Exact test/production values: ../../LICENSING.md
LICENSE_SERVICE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
LICENSE_SERVICE_KEY=REPLACE_WITH_SUPABASE_ANON_OR_PUBLISHABLE_KEY
LICENSE_SIGNING_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_KEY_BASE64
# Generate a different value for every customer with: openssl rand -base64 32
LICENSE_INSTALLATION_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_32_BYTE_BASE64_KEY
LICENSE_REFRESH_INTERVAL_HOURS=24
