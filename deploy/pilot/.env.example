# Copy to deploy/pilot/.env and replace every CHANGE_ME value.
# Never commit the resulting file.
COMPOSE_PROJECT_NAME=silonr-pilot

# Public DNS records pointing to the server running Caddy.
SILONR_DOMAIN=silonr.example.com
SILONR_FILES_DOMAIN=files.silonr.example.com
ACME_EMAIL=admin@example.com

# Database credentials. Use long, unique random values.
POSTGRES_DB=silonr
POSTGRES_USER=silonr
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD_20_CHARS_MINIMUM

# Better Auth: at least 32 random characters.
BETTER_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# MinIO root credentials are used only to bootstrap/administer private storage.
# They must not be reused by the application.
MINIO_ROOT_USER=silonr-storage-root
MINIO_ROOT_PASSWORD=CHANGE_ME_STORAGE_ROOT_PASSWORD_20_CHARS_MINIMUM

# Least-privilege S3 identity used by SiloNR after bootstrap.
# create-bucket creates/enables this MinIO user and attaches a bucket-scoped policy.
S3_ACCESS_KEY_ID=silonr-app
S3_SECRET_ACCESS_KEY=CHANGE_ME_APP_STORAGE_PASSWORD_20_CHARS_MINIMUM
S3_BUCKET=silonr-private

# Optional error monitoring endpoint. Leave blank until a provider is configured.
SENTRY_DSN=
